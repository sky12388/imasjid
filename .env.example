# FirebaseWeb app config (used only by the AJK / admin portal)
# Create a Firebase project, enable Authentication > Sign-in method > Email/Password,
# then paste the values from Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public origin, used for canonical URLs / share metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
